      "url": "https://travinsy.com/r/theme-red.json",
      "install": {
        "url": "pnpm dlx shadcn@latest add https://travinsy.com/r/theme-red.json",
        "namespaced": "pnpm dlx shadcn@latest add @travinsy/theme-red"
