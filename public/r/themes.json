{
  "name": "travinsy-themes",
  "homepage": "https://travinsy.com",
  "themes": [
    {
      "id": "neutral",
      "group": "base",
      "name": "中性",
      "title": "Neutral",
      "description": "没有色相的纯灰，shadcn 的默认外观。",
      "url": "https://travinsy.com/r/theme-neutral.json",
      "install": {
        "url": "pnpm dlx shadcn@latest add https://travinsy.com/r/theme-neutral.json",
        "namespaced": "pnpm dlx shadcn@latest add @travinsy/theme-neutral"
      }
    },
    {
      "id": "stone",
      "group": "base",
      "name": "石色",
      "title": "Stone",
      "description": "偏暖的灰，带一点米褐调，比纯灰更柔和。",
      "url": "https://travinsy.com/r/theme-stone.json",
      "install": {
        "url": "pnpm dlx shadcn@latest add https://travinsy.com/r/theme-stone.json",
        "namespaced": "pnpm dlx shadcn@latest add @travinsy/theme-stone"
      }
    },
    {
      "id": "slate",
      "group": "base",
      "name": "板岩",
      "title": "Slate",
      "description": "偏冷的蓝灰，背景、边框和文字都带蓝调，适合技术站和文档站。",
      "url": "https://travinsy.com/r/theme-slate.json",
      "install": {
        "url": "pnpm dlx shadcn@latest add https://travinsy.com/r/theme-slate.json",
        "namespaced": "pnpm dlx shadcn@latest add @travinsy/theme-slate"
      }
    },
    {
      "id": "red",
      "group": "color",
      "name": "红色",
      "title": "Red",
